@model List<WebAppStudents.Models.AcademicGroupViewModel>

@{
    ViewData["Title"] = "Академические группы";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Список академических групп</h2>
    <a asp-action="AcademicGroupCreateView" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Добавить группу
    </a>
</div>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">
        Список групп пуст. Добавьте первую группу.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 15%;">ID</th>
                <th>Название группы</th>
                <th style="width: 25%;" class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var groupItem in Model)
            {
                <tr>
                    <td>@groupItem.AcademicGroupId</td>
                    <td>@groupItem.Name</td>
                    <td class="text-end">
                        <div class="btn-group" role="group">
                            <a asp-action="AcademicGroupDetailsView"
                               asp-route-id="@groupItem.AcademicGroupId"
                               class="btn btn-outline-info btn-sm"
                               title="Просмотр">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="AcademicGroupEditView"
                               asp-route-id="@groupItem.AcademicGroupId"
                               class="btn btn-outline-warning btn-sm"
                               title="Редактировать">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="AcademicGroupDeleteView"
                               asp-route-id="@groupItem.AcademicGroupId"
                               class="btn btn-outline-danger btn-sm"
                               onclick="return confirm('Удалить группу @groupItem.Name?');"
                               title="Удалить">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}