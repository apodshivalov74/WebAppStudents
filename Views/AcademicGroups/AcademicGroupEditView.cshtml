@model WebAppStudents.Models.AcademicGroupViewModel

@{
    bool isNew = Model.AcademicGroupId == 0;
    ViewData["Title"] = isNew ? "Новая группа" : "Редактирование группы";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@(isNew ? "Создание академической группы" : "Редактирование группы")</h4>
            </div>
            <div class="card-body">
                <form asp-action="AcademicGroupUpdate" method="post">
                    <!-- Скрытое поле для сохранения ID существующей группы -->
                    <input type="hidden" asp-for="AcademicGroupId" />

                    @if (!isNew)
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted">ID группы</label>
                            <input class="form-control" value="@Model.AcademicGroupId" disabled />
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Название группы</label>
                        <input asp-for="Name" class="form-control" placeholder="Например: ПИ-332" required />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="AcademicGroupsListView" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Назад к списку
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg"></i> Сохранить
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>