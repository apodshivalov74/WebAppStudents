@model WebAppStudents.Models.StudentViewModel

@{
    ViewData["Title"] = "Редактирование Студента";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="StudentUpdate" asp-controller="Students">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- скрытый input для id -->
            @Html.HiddenFor(x => x.StudentViewModelId)

            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Age" class="control-label"></label>
                <input asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <!--            
            <div class="form-group">
                <label asp-for="AcademicGroup" class="control-label"></label>
                <input asp-for="AcademicGroup" class="form-control" />
                <span asp-validation-for="AcademicGroup" class="text-danger"></span>
            </div>
            -->
            <div>
                <label asp-for="AcademicGroup" class="control-label">Группа</label>
                @Html.DropDownList(
                    "AcademicGroup",
                    Model.ListAcademicGroup,
                    "Выберите группу",
                    new { @class = "form-select" }
                )
            </div>

            <div class="form-group">
                <input type="submit" 
                    value="Сохранить" 
                    class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="StudentsListView" class="btn btn-secondary mt-3">К списку студентов</a>
</div>
