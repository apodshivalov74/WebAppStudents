@model IEnumerable<WebAppStudents.Models.StudentViewModel>

@{
    ViewData["Title"] = "список студентов";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="StudentCreateView" class="btn btn-primary">
        Добавить
    </a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Age)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AcademicGroup)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(model => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Age)
            </td>
            <td>
                @Html.DisplayFor(model => item.AcademicGroup)
            </td>
            <td>
                <a class="btn btn-outline-warning"
                    asp-action="StudentEditView" 
                    asp-route-id="@item.StudentViewModelId">
                    Изменить
                        <i class="bi bi-pencil"></i>
                </a> |

                <a class="btn btn-outline-secondary"
                    asp-action="StudentDetailsView" 
                    asp-route-id="@item.StudentViewModelId">
                    Подробно
                </a> |

                <a class="btn btn-outline-danger"
                    asp-action="StudentDeleteView" 
                    asp-route-id="@item.StudentViewModelId">
                Удалить
                </a>
            </td>
        </tr>
}
    </tbody>
</table>

<a asp-action="Index" class="btn btn-primary">
    На главную
</a>
